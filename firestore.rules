rules_version = '2';

// SHARED PROJECT: this Firebase project (trialmatchrx-v2) serves BOTH
// IVida Health and TrialMatchRx. Keep both sections whenever you publish,
// from either codebase, or one app will lose access to its data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =====================================================================
    // IVida Health
    // =====================================================================

    // Patients can only read/write their own data
    match /patients/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lab results — patient-owned
    match /patients/{userId}/labResults/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Medications — patient-owned
    match /patients/{userId}/medications/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Visits — patient-owned
    match /patients/{userId}/visits/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Providers — patient-owned
    match /patients/{userId}/providers/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Share tokens — patient creates, anyone with token can read (read-only)
    match /shareTokens/{token} {
      allow create: if request.auth != null;
      allow read: if true;  // Public read for share links
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // Shared access log — audit trail
    match /shareAccess/{docId} {
      allow create: if true;  // Anyone viewing logs an access
      allow read: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    // =====================================================================
    // TrialMatchRx
    // =====================================================================

    // Trials — publicly readable, server-side writes only
    match /trials/{trialId} {
      allow read: if true;
      allow write: if false;
    }

    // Users — each user reads/writes only their own profile
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Alerts — users manage their own
    match /alerts/{alertId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Search history — users read their own
    match /searchHistory/{searchId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Trial Matcher whitelist — doc ID is the lowercase email.
    // A signed-in user may read only their own entry (the access check).
    // Writes go through the admin API (firebase-admin bypasses rules).
    match /trial_matcher_users/{email} {
      allow read: if isAuthenticated()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Trial sync metadata — public read, server-side writes only
    match /metadata/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
